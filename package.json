{
  "name": "customer-support-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Customer Support CRM (MVP: core ticketing) — see SPEC.md / PLAN.md",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web",
    "test": "npm run test --workspace server",
    "test:web": "npm run test --workspace web",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "seed": "npm run seed --workspace server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.13"
  }
}
