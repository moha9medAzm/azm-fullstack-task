# Copy to .env and adjust. All values below are safe local defaults.

# Prisma / SQLite connection string (relative to server/prisma)
DATABASE_URL="file:./dev.db"

# Secret used to sign JWTs. Use a long random string in any real deployment.
JWT_SECRET="dev-only-change-me-please-0123456789abcdef"

# JWT lifetime
JWT_EXPIRES_IN="8h"

# HTTP port for the API
PORT=4000

# Comma-separated list of allowed browser origins (the web app)
CORS_ORIGIN="http://localhost:5173"

# How often the background SLA sweep runs, in milliseconds (0 disables it)
SLA_SWEEP_MS=60000

# bcrypt cost factor
BCRYPT_ROUNDS=10

# "development" | "test" | "production"
NODE_ENV=development
